# Cadena de conexión PostgreSQL proporcionada por Neon/Vercel.
DATABASE_URL="postgresql://USUARIO:CONTRASENA@HOST/BASE_DE_DATOS?sslmode=require"

# Clave utilizada para firmar las cookies de sesión.
# Genere una cadena aleatoria larga antes de desplegar.
SESSION_SECRET="reemplace-este-valor-por-una-clave-aleatoria-de-al-menos-32-caracteres"
